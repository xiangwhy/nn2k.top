---
const pathname = Astro.url.pathname;
const nav = [
  { href: '/', label: '首页' },
  { href: '/projects/', label: '项目' },
  { href: '/about/', label: '关于' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-name">nn2k</span>
      <span class="brand-seal" aria-hidden="true">翔</span>
    </a>
    <nav class="nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={['nav-link', { active: isActive(item.href) }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--c-rule);
    padding-block: var(--s-4);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-6);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    text-decoration: none;
    font-family: var(--ff-display);
    font-size: var(--t-xl);
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--c-ink);
  }

  .brand:hover {
    color: var(--c-ink);
  }

  .brand-seal {
    display: inline-grid;
    place-items: center;
    width: 1.1em;
    height: 1.1em;
    background: var(--c-seal);
    color: var(--c-paper);
    font-family: var(--ff-display);
    font-weight: 500;
    font-size: 0.7em;
    line-height: 1;
    transform: rotate(-3deg);
    border-radius: 2px;
  }

  .nav {
    display: flex;
    gap: var(--s-6);
  }

  .nav-link {
    font-size: var(--t-sm);
    color: var(--c-muted);
    text-decoration: none;
    padding-block: var(--s-1);
    border-bottom: 1px solid transparent;
  }

  .nav-link:hover {
    color: var(--c-ink);
    border-bottom-color: var(--c-rule);
  }

  .nav-link.active {
    color: var(--c-ink);
    border-bottom-color: var(--c-seal);
  }

  @media (max-width: 480px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-3);
    }
    .nav {
      gap: var(--s-4);
    }
  }
</style>