---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
---

<div class="row">
  <span class="year">{data.year}</span>
  <div class="body">
    <h3 class="title">
      <a href={`/projects/${project.id}/`}>{data.title}</a>
    </h3>
    <p class="summary">{data.summary}</p>
  </div>
  <div class="meta">
    {
      data.tags.length > 0 && (
        <ul class="tags" aria-label="标签">
          {data.tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      )
    }
    {
      data.downloads && data.downloads.length > 0 && (
        <ul class="downloads" aria-label="下载">
          {data.downloads.map((d) => (
            <li>
              <a
                class="dl"
                href={d.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {d.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <span class="arrow" aria-hidden="true">→</span>
</div>

<style>
  .row {
    display: grid;
    /* Fixed meta column: tags + downloads share it, so the body column keeps
     * the same width on every row and the arrows line up. */
    grid-template-columns: 4rem minmax(0, 1fr) 14rem 1.5rem;
    align-items: baseline;
    column-gap: var(--s-6);
    padding-block: var(--s-6);
    border-top: 1px solid var(--c-rule);
    color: var(--c-ink);
  }

  /* Last row of the list closes the band */
  .row:last-child {
    border-bottom: 1px solid var(--c-rule);
  }

  /* hover targets the title link only — keeps the row from feeling like a giant hit area */
  .row:hover .title a {
    color: var(--c-seal);
  }

  .row:hover .arrow {
    color: var(--c-seal);
    transform: translateX(4px);
  }

  .year {
    font-family: var(--ff-mono);
    font-size: var(--t-sm);
    color: var(--c-muted);
    letter-spacing: 0.05em;
    /* align baseline with the title */
    padding-top: 0.55em;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    min-width: 0;
  }

  .title {
    font-family: var(--ff-display);
    font-size: var(--t-xl);
    font-weight: 500;
    margin: 0;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .title a:hover {
    color: var(--c-seal);
  }

  .summary {
    margin: 0;
    color: var(--c-muted);
    font-size: var(--t-base);
    line-height: 1.55;
    /* soft clamp so very long summaries don't blow up the row */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-2);
  }

  .arrow {
    color: var(--c-muted);
    font-size: var(--t-base);
    align-self: center;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .downloads {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--ff-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
    letter-spacing: 0.05em;
    white-space: nowrap;
  }

  .downloads li {
    display: inline;
  }

  .downloads li:not(:last-child)::after {
    content: '·';
    color: var(--c-rule);
    margin: 0 var(--s-2);
  }

  .dl {
    color: var(--c-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    padding-bottom: 1px;
    font-weight: 500;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .dl:hover {
    color: var(--c-seal);
    border-bottom-color: var(--c-seal);
  }

  .dl span[aria-hidden] {
    font-size: 0.85em;
    color: var(--c-muted);
    vertical-align: baseline;
    position: relative;
    top: -0.05em;
    transition: color 0.2s ease;
  }

  .dl:hover span[aria-hidden] {
    color: var(--c-seal);
  }

  @media (max-width: 700px) {
    .row {
      grid-template-columns: 3.5rem minmax(0, 1fr) auto;
      grid-template-areas:
        'year body arrow'
        'meta meta meta';
      column-gap: var(--s-4);
      row-gap: var(--s-2);
      padding-block: var(--s-6);
    }
    .year {
      grid-area: year;
      padding-top: 0.3em;
    }
    .body {
      grid-area: body;
    }
    .meta {
      grid-area: meta;
    }
    .arrow {
      grid-area: arrow;
      align-self: start;
      padding-top: 0.3em;
    }
  }
</style>