---
import Seal from './Seal.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <span class="copy">© {year} nn2k.top</span>
    <span class="seal-mark" aria-hidden="true">
      <Seal size={24} />
    </span>
    <span class="end">完</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--c-rule);
    padding-block: var(--s-6);
    margin-top: var(--s-16);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    font-size: var(--t-xs);
    color: var(--c-muted);
    font-family: var(--ff-mono);
    letter-spacing: 0.02em;
  }

  .copy {
    text-transform: uppercase;
  }

  .seal-mark {
    display: inline-flex;
    /* The footer thumb reuses the full Seal component so it inherits the
     * hand-pressed detail (inset highlight + outer ring) at small size. */
  }

  .end {
    font-family: var(--ff-display);
    font-size: var(--t-base);
    color: var(--c-muted);
    /* small optical balance against the Latin copy on the left */
    letter-spacing: 0.05em;
  }
</style>
