---
/**
 * Seal — the site's signature mark. A single 朱砂 (cinnabar) square with a
 * character inside, used sparingly. Slight rotation gives it the "freshly
 * stamped" feel of a real 印章.
 *
 * Sizes sensibly: inset highlight, drop shadow, and outer ring all scale
 * with `--seal-size` so the same mark works at 96px (hero) and 24px (footer).
 */
interface Props {
  /** The character rendered inside the seal. Defaults to 翔. */
  char?: string;
  /** Pixel size. */
  size?: number;
}

const { char = '翔', size = 96 } = Astro.props;
---

<span
  class="seal"
  role="img"
  aria-label={`印章 · ${char}`}
  style={`--seal-size: ${size}px`}
>
  <span class="seal-char">{char}</span>
</span>

<style>
  .seal {
    display: inline-grid;
    place-items: center;
    width: var(--seal-size, 96px);
    height: var(--seal-size, 96px);
    background: var(--c-seal);
    color: var(--c-paper);
    transform: rotate(-4deg);
    box-shadow:
      inset 0 0 0 calc(var(--seal-size, 96px) * 0.025)
        rgba(241, 238, 231, 0.15),
      0 calc(var(--seal-size, 96px) * 0.012) 0
        rgba(26, 24, 20, 0.08);
    position: relative;
  }

  /* Hand-pressed distress: a thin outer ring; sized with the seal itself. */
  .seal::before {
    content: '';
    position: absolute;
    inset: calc(var(--seal-size, 96px) * -0.035);
    border: 1px solid rgba(181, 48, 42, 0.35);
    pointer-events: none;
  }

  .seal-char {
    font-family: var(--ff-display);
    font-weight: 500;
    font-size: calc(var(--seal-size, 96px) * 0.55);
    line-height: 1;
    /* optical centering for the single glyph */
    padding-bottom: 6%;
  }
</style>