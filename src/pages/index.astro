---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ProjectRow from '../components/ProjectRow.astro';

const all = await getCollection('projects', ({ data }) => !data.draft);
const sorted = all.sort(
  (a, b) =>
    b.data.order - a.data.order || b.data.year - a.data.year,
);
const featured = sorted.filter((p) => p.data.featured);
const rest = sorted.filter((p) => !p.data.featured);

const allLinks = await getCollection('links', ({ data }) => !data.draft);
const recent = allLinks
  .sort((a, b) => b.data.taken_at.getTime() - a.data.taken_at.getTime())
  .slice(0, 3);
---

<Base title="nn2k.top">
  <section class="hero container">
    <div class="hero-text">
      <p class="eyebrow">作品集 · {new Date().getFullYear()}</p>
      <h1 class="hero-name">
        做过的一些<span class="hero-em">东西</span>，
        写过的几行<span class="hero-em">字</span>。
      </h1>
      <p class="hero-bio">
        自从有了 AI，把很多以前没办法实现的想法慢慢做出来了 — 这个站是把其中几个攒起来的地方。
      </p>
      <p class="hero-links">
        <a href="/projects/">查看全部项目 →</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="/about/">关于</a>
      </p>
    </div>
    <div class="hero-seal">
      <Seal size={96} />
    </div>
  </section>

  {
    featured.length > 0 && (
      <section class="container section" data-reveal>
        <header class="section-head">
          <h2 class="section-title">重点项目</h2>
          <span class="section-dots" aria-hidden="true">· · ·</span>
          <span class="section-rule" aria-hidden="true" />
        </header>
        <div class="grid grid--featured">
          {featured.map((p) => (
            <ProjectCard project={p} featured />
          ))}
        </div>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="container section" data-reveal>
        <header class="section-head">
          <h2 class="section-title">其他</h2>
          <span class="section-dots" aria-hidden="true">· · ·</span>
          <span class="section-rule" aria-hidden="true" />
        </header>
        <div class="list" role="list">
          {rest.map((p) => (
            <ProjectRow project={p} />
          ))}
        </div>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section class="container section" data-reveal>
        <header class="section-head">
          <h2 class="section-title">最近的网摘</h2>
          <span class="section-dots" aria-hidden="true">· · ·</span>
          <span class="section-rule" aria-hidden="true" />
          <a href="/links/" class="section-more">全部 →</a>
        </header>
        <ol class="recent" role="list">
          {recent.map((l) => (
            <li class="recent-item">
              <time
                class="recent-date"
                datetime={l.data.taken_at.toISOString()}
              >
                {String(l.data.taken_at.getMonth() + 1).padStart(2, '0')}.
                {String(l.data.taken_at.getDate()).padStart(2, '0')}
              </time>
              <a
                class="recent-title"
                href={l.data.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {l.data.title}
                <span class="ext" aria-hidden="true">↗</span>
              </a>
              {l.data.source && (
                <span class="recent-source">{l.data.source}</span>
              )}
            </li>
          ))}
        </ol>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: var(--s-8);
    padding-block: var(--s-16) var(--s-12);
  }

  .hero-text {
    max-width: 32rem;
    /* fade-in-up entrance for the headline area */
    animation: hero-enter 0.6s ease-out both;
    animation-delay: 0.05s;
  }

  .eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-muted);
    margin-bottom: var(--s-4);
  }

  .hero-name {
    font-size: clamp(var(--t-2xl), 5vw, var(--t-4xl));
    line-height: 1.15;
    margin-bottom: var(--s-6);
  }

  .hero-em {
    color: var(--c-seal);
  }

  .hero-bio {
    color: var(--c-muted);
    font-size: var(--t-lg);
    line-height: 1.6;
    margin-bottom: var(--s-6);
  }

  .hero-links {
    font-size: var(--t-sm);
    color: var(--c-muted);
  }

  .hero-links a {
    text-decoration: none;
    border-bottom: 1px solid var(--c-rule);
    padding-bottom: 1px;
  }

  .dot {
    margin-inline: var(--s-2);
  }

  .hero-seal {
    justify-self: end;
    align-self: start;
    margin-top: var(--s-2);
    /* stamp-press micro animation. fill-mode backwards keeps the 0%
     * (invisible, oversized) state during the delay; ending at transform:none
     * lets .seal's own rotate(-4deg) stand alone — no double rotation. */
    animation: seal-stamp 0.45s cubic-bezier(0.2, 0.7, 0.3, 1.2) backwards;
    animation-delay: 0.15s;
  }

  .section {
    padding-block: var(--s-8);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    margin-bottom: var(--s-6);
  }

  .section-title {
    font-family: var(--ff-display);
    font-size: var(--t-xl);
    font-weight: 500;
    margin: 0;
    color: var(--c-muted);
  }

  .section-dots {
    font-family: var(--ff-mono);
    font-size: var(--t-base);
    color: var(--c-rule);
    letter-spacing: 0.2em;
    flex-shrink: 0;
  }

  .section-rule {
    flex: 1;
    align-self: center;
    height: 0;
    border-top: 1px dotted var(--c-rule);
    margin: 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--s-4);
  }

  .grid--featured {
    grid-template-columns: 1fr;
  }

  .list {
    margin-top: var(--s-2);
  }

  .section-more {
    font-family: var(--ff-mono);
    font-size: var(--t-sm);
    color: var(--c-muted);
    text-decoration: none;
    flex-shrink: 0;
    margin-left: var(--s-4);
    letter-spacing: 0.02em;
  }

  .section-more:hover {
    color: var(--c-seal);
  }

  .recent {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .recent-item {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    column-gap: var(--s-4);
    padding-block: var(--s-4);
    border-top: 1px solid var(--c-rule);
  }

  .recent-item:last-child {
    border-bottom: 1px solid var(--c-rule);
  }

  .recent-date {
    font-family: var(--ff-mono);
    font-size: var(--t-sm);
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
  }

  .recent-title {
    font-family: var(--ff-display);
    font-size: var(--t-base);
    font-weight: 500;
    color: var(--c-ink);
    text-decoration: none;
    line-height: 1.4;
    letter-spacing: -0.005em;
  }

  .recent-title:hover {
    color: var(--c-seal);
  }

  .recent-title .ext {
    font-family: var(--ff-mono);
    font-size: 0.85em;
    color: var(--c-muted);
  }

  .recent-title:hover .ext {
    color: var(--c-seal);
  }

  .recent-source {
    font-family: var(--ff-mono);
    font-size: var(--t-xs);
    color: var(--c-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  @media (max-width: 600px) {
    .recent-item {
      grid-template-columns: 3rem 1fr;
      grid-template-areas:
        'date title'
        'source source';
      row-gap: var(--s-1);
    }
    .recent-date {
      grid-area: date;
    }
    .recent-title {
      grid-area: title;
    }
    .recent-source {
      grid-area: source;
    }
  }

  @keyframes hero-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes seal-stamp {
    0% {
      opacity: 0;
      transform: rotate(-15deg) scale(1.4);
    }
    60% {
      opacity: 1;
      transform: rotate(-3deg) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 600px) {
    .hero {
      grid-template-columns: 1fr;
      row-gap: var(--s-8);
      padding-block: var(--s-12) var(--s-8);
    }
    .hero-seal {
      justify-self: start;
      order: -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-text,
    .hero-seal {
      animation: none;
    }
  }
</style>