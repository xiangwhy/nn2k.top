---
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';
---

<Base title="404" description="这里没有那个页。">
  <section class="container miss" data-reveal>
    <div class="miss-seal"><Seal size={120} /></div>
    <p class="eyebrow">404 · 走丢了</p>
    <h1 class="miss-title">这个页不在这里。</h1>
    <p class="miss-body">
      可能链接写错了，或者这个角落还没整理好。<br />
      回首页看看，或者翻翻做过的项目。
    </p>
    <p class="miss-links">
      <a href="/">回首页 →</a>
      <span class="dot" aria-hidden="true">·</span>
      <a href="/projects/">看项目 →</a>
    </p>
  </section>
</Base>

<style>
  .miss {
    padding-block: var(--s-16);
    max-width: 36rem;
    margin-inline: auto;
    text-align: center;
  }

  .miss-seal {
    display: flex;
    justify-content: center;
    margin-bottom: var(--s-8);
  }

  .eyebrow {
    font-family: var(--ff-mono);
    font-size: var(--t-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--c-muted);
    margin-bottom: var(--s-4);
  }

  .miss-title {
    font-size: clamp(var(--t-2xl), 5vw, var(--t-4xl));
    margin-bottom: var(--s-6);
    line-height: 1.25;
  }

  .miss-body {
    color: var(--c-muted);
    font-size: var(--t-lg);
    line-height: 1.7;
    margin-bottom: var(--s-8);
  }

  .miss-links {
    font-family: var(--ff-mono);
    font-size: var(--t-sm);
    color: var(--c-muted);
  }

  .dot {
    color: var(--c-rule);
    margin-inline: var(--s-3);
  }
</style>
