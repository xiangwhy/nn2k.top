# 允许 esbuild / workerd / parcel-watcher / sharp 在 install 时跑原生构建脚本
# pnpm 10 在 .npmrc 读这个; pnpm 11 改成在 pnpm-workspace.yaml 的 allowBuilds 读
# 新增依赖后若遇到 "Ignored build scripts", 运行:
#   pnpm approve-builds <pkg-name>   # pnpm 11
# 或手动加到下面的 only-built-dependencies 列表里 (pnpm 10 / CI 通用)
only-built-dependencies[]=esbuild
only-built-dependencies[]=workerd
only-built-dependencies[]=@parcel/watcher
only-built-dependencies[]=sharp